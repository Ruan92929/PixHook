{
  "ConnectionStrings": {
    "PixHook": "Data Source=pixhook.db"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Dispatcher": {
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "MaxResponseBodyLength": 8000
  },
  "Signing": {
    "DefaultSecret": "pixhook-dev-secret",
    "Secrets": {
      "mercadopago": "mp-webhook-secret-dev",
      "hmac-sha256": "pixhook-dev-secret"
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/pixhook-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
