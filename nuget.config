<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- O PixHook usa apenas pacotes públicos: ignora feeds privados configurados na máquina. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
